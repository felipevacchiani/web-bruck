# ================================================
# BRUCK PORTAL - Variables de entorno
# Copiar como .env.local y completar los valores
# NUNCA commitear .env.local al repositorio
# ================================================

# --- Supabase (obtener en: supabase.com > tu proyecto > Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyXXXXXXXXXXXXXXX

# SERVICE ROLE - NUNCA exponer al browser, solo en server-side
# Obtener en: Supabase > Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=eyXXXXXXXXXXXXXXX

# --- URLs ---
# En desarrollo: http://localhost:3001
# En producción: https://portal.somosbruck.com
NEXT_PUBLIC_SITE_URL=https://portal.somosbruck.com
